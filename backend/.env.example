PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_bytes
CLIENT_ORIGIN=https://your-frontend.vercel.app
NODE_ENV=production

# Cloudinary dùng để lưu ảnh dự án và file ZIP.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Chỉ cần khi chạy npm run create-admin; không commit mật khẩu thật.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrator

# SMTP dùng cho email quên mật khẩu.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@example.com

# ── Frontend (.env khi build) ─────────────────────────────────────────────────
# VITE_API_URL=https://your-backend.vercel.app   (để trống nếu cùng domain)
# VITE_SITE_URL=https://your-frontend.vercel.app
